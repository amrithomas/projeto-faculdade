# Variáveis usadas pelo docker-compose.yml (serviço mysql/phpmyadmin).
# Mantenha os valores de DB_DATABASE / DB_USERNAME / DB_PASSWORD iguais
# aos que estão em back/.env, senão o Laravel não vai conseguir logar no banco.
DB_DATABASE=pokedex
DB_USERNAME=pokedex
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
