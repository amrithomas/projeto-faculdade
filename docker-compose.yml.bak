services:
  app:
    build:
      context: ./back
      dockerfile: Dockerfile
    container_name: pokedex_app
    volumes:
      - ./back:/var/www/html
      - pokedex_vendor:/var/www/html/vendor
    depends_on:
      mysql:
        condition: service_healthy
    networks:
      - pokedex

  nginx:
    image: nginx:alpine
    container_name: pokedex_nginx
    ports:
      - "8000:80"
    volumes:
      - ./back:/var/www/html
      - ./docker/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - app
    networks:
      - pokedex

  mysql:
    image: mysql:8.4
    container_name: pokedex_mysql
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: ${DB_DATABASE:-pokedex}
      MYSQL_USER: ${DB_USERNAME:-pokedex}
      MYSQL_PASSWORD: ${DB_PASSWORD:-secret}
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD:-root}
    ports:
      - "3306:3306"
    volumes:
      - pokedex_mysql_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u", "root", "-p${DB_ROOT_PASSWORD:-root}"]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - pokedex

  front:
    build:
      context: ./front
      dockerfile: Dockerfile
    container_name: pokedex_front
    volumes:
      - ./front:/app
      - pokedex_front_node_modules:/app/node_modules
    ports:
      - "5173:5173"
    depends_on:
      - nginx
    networks:
      - pokedex

  phpmyadmin:
    image: phpmyadmin:latest
    container_name: pokedex_phpmyadmin
    environment:
      PMA_HOST: mysql
      PMA_USER: root
      PMA_PASSWORD: ${DB_ROOT_PASSWORD:-root}
    ports:
      - "8080:80"
    depends_on:
      - mysql
    networks:
      - pokedex

networks:
  pokedex:
    driver: bridge

volumes:
  pokedex_mysql_data:
  pokedex_vendor:
  pokedex_front_node_modules:
