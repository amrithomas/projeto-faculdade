# Variáveis usadas pelo docker-compose.yml (serviço mysql/phpmyadmin).
# Mantenha os valores de DB_DATABASE / DB_USERNAME / DB_PASSWORD iguais
# aos que estão em back/.env, senão o Laravel não vai conseguir logar no banco.
DB_DATABASE=pokedex
DB_USERNAME=pokedex
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# Chave da API da Anthropic (console.anthropic.com), usada só pelo container
# "battle" pra IA das dificuldades médio/difícil. Sem ela, o oponente joga no
# aleatório.
ANTHROPIC_API_KEY=
